{
  "name": "autarq-hub",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "cucumber": "cucumber-js --config specs/cucumber.config.js",
    "test:bdd": "start-server-and-test \"pnpm --filter @autarq/web start:standalone\" http://localhost:3000 \"pnpm run cucumber\"",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": "eslint --flag v10_config_lookup_from_file --max-warnings 0 --no-warn-ignored",
    "*.md": "markdownlint-cli2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@cucumber/cucumber": "^13.0.0",
    "@cucumber/html-formatter": "^24.0.0",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "cucumber-tsflow": "^4.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.9.1",
    "start-server-and-test": "3.0.11",
    "ts-node": "10.9.2",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "version": "1.0.0"
}
